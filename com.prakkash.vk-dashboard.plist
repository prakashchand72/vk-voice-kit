<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.prakkash.vk-dashboard</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3.14</string>
    <string>/Users/prakkash/.voice-kit/vk-dashboard.py</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>ThrottleInterval</key><integer>10</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/prakkash/.voice-kit/dashboard.log</string>
  <key>StandardErrorPath</key><string>/Users/prakkash/.voice-kit/dashboard.log</string>
</dict>
</plist>
