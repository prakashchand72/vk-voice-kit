#!/bin/bash
# vk — voice kit: local push-to-talk dictation for opencode (DIY superwhisper)
# Mic is NEVER hardcoded: auto-detects at every run, or pin one with `vk mic`.

KIT="$HOME/.voice-kit"
MODEL="$KIT/models/ggml-large-v3-turbo.bin"
WAV="/tmp/vk-voice.wav"
HOLD_WAV="/tmp/vk-hold.wav"
RAW="/tmp/vk-raw.wav"
CFG="$KIT/config"
SILENCE_THRESHOLD="0.008"

[ -f "$CFG" ] && source "$CFG"

VOCAB_PROMPT="Voice command for a security testing CLI agent. Technical terms: nmap, nikto, nuclei, sqlmap, Burp Suite, Caido, httpql, subfinder, amass, ffuf, httpx, naabu, metasploit, hydra, hashcat, opencode, XSS, SSRF, IDOR, RCE, payload, subdomain, recon, bash, zsh, grep, curl, localhost, GraphQL, API."

FORMAT_PROMPT='You are a formatter for voice-dictated instructions that get pasted into a coding and security-testing CLI agent. Rewrite the raw speech-to-text transcript into a clean, concise instruction.
Rules:
- Correct misrecognized technical terms: nmap, nikto, nuclei, sqlmap, Burp Suite, Caido, httpql, subfinder, amass, ffuf, gf, opencode, XSS, SSRF, RCE, IDOR, CVSS, payload, exploit, recon, subdomain, endpoint, JavaScript, Python, bash, grep, curl.
- Remove filler words (um, uh, like, you know) and stuttered repeats.
- Preserve the users intent exactly. Do NOT answer, execute, explain, or add suggestions - only clean up what was said.
- Preserve the users intent EXACTLY and COMPLETELY. If they ask for extra actions (save output, open a file, send results somewhere, follow-ups), those must appear in the output - never drop parts of the request.
- Spell tool names, flags, file paths, and URLs precisely. Use backticks only around literal commands or code.
- Output ONLY the formatted instruction. No quotes, no preamble, no commentary.'

# ---------- mic management ----------

input_devices() {
  # print input-capable coreaudio device names, one per line
  system_profiler SPAudioDataType -json 2>/dev/null | python3 -c '
import json, sys
try:
    items = json.load(sys.stdin)["SPAudioDataType"][0]["_items"]
    for d in items:
        if d.get("coreaudio_device_input", 0) in (0, None):
            continue
        if "channels" in str(d.get("coreaudio_device_input", "")):
            continue
        n = d.get("coreaudio_device_input")
        if isinstance(n, dict) or not n:
            continue
        print(d["_name"])
except Exception:
    pass'
}

is_virtual() {
  case "$(echo "$1" | tr '[:upper:]' '[:lower:]')" in
    *blackhole*|*loopback*|*aggregat*|*multio*|*cam*|*teams*) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_mic() {
  if [ -n "$VK_MIC" ] && [ "$VK_MIC" != "auto" ]; then
    if input_devices | grep -qxF "$VK_MIC"; then
      echo "$VK_MIC"; return
    fi
    echo "⚠️  saved mic '$VK_MIC' not connected - falling back to system default..." >&2
  fi
  echo "default"
}

# ---------- pipeline ----------

WHISPER_PORT="${VK_WHISPER_PORT:-8081}"

transcribe_cli() {
  local wav="$1"
  whisper-cli -m "$MODEL" -f "$wav" -nt -np --prompt "$VOCAB_PROMPT" 2>/dev/null \
    | sed '/^[[:space:]]*$/d' \
    | sed 's/\[[a-zA-Z_]*\]//g' \
    | tr '\n' ' ' \
    | sed 's/[[:space:]]*$//'
}

transcribe_http() {
  local wav="$1" out
  out=$(curl -s --max-time 60 -F "file=@$wav" "http://127.0.0.1:$WHISPER_PORT/inference" 2>/dev/null \
    | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin).get("text","").strip())
except Exception:
    sys.exit(1)')
  [ -n "$out" ] && echo "$out"
}

transcribe() {
  local wav="$1"
  if curl -s --max-time 1 -o /dev/null "http://127.0.0.1:$WHISPER_PORT/inference" 2>/dev/null; then
    transcribe_http "$wav" && return
  fi
  transcribe_cli "$wav"
}

format_llm() {
  local text="$1"
  [ "$VK_RAW" = "1" ] && { echo "$text"; return; }
  local key="${VK_FORMAT_KEY:-$GROQ_API_KEY}"
  [ -z "$key" ] && { echo "$text"; return; }
  local url="${VK_FORMAT_URL:-https://api.groq.com/openai/v1/chat/completions}"
  local payload out
  payload=$(FORMAT_PROMPT="$FORMAT_PROMPT" python3 -c '
import json, os, sys
print(json.dumps({
  "model": os.environ.get("VK_FORMAT_MODEL", "openai/gpt-oss-20b"),
  "messages": [
    {"role": "system", "content": os.environ["FORMAT_PROMPT"]},
    {"role": "user", "content": sys.argv[1]}
  ],
  "temperature": 0.1
}))' "$text")
  out=$(curl -s --max-time 12 "$url" \
    -H "Authorization: Bearer $key" \
    -H "Content-Type: application/json" \
    -d "$payload" \
    | python3 -c 'import json,sys
try:
    print(json.load(sys.stdin)["choices"][0]["message"]["content"].strip())
except Exception:
    sys.exit(1)')
  [ -n "$out" ] && echo "$out" || echo "$text"
}

peak_of() {
  sox "$1" -n stat 2>&1 | awk '/Maximum amplitude:/ {print $3}'
}

record() {
  local secs="${1:-6}"
  local mic
  mic=$(resolve_mic)
  if [ -z "$mic" ]; then
    echo "❌ no input microphone found" >&2
    exit 1
  fi
  echo "🎙  [$mic] recording ${secs}s — SPEAK NOW" >&2
  sox -q -t coreaudio "$mic" "$RAW" trim 0 "$secs" 2>/dev/null
  sox "$RAW" -r 16000 -c 1 "$WAV" 2>/dev/null
  local peak
  peak=$(peak_of "$WAV")
  if python3 -c "import sys; sys.exit(0 if float(sys.argv[1] or 0) < $SILENCE_THRESHOLD else 1)" "$peak"; then
    echo "⚠️  captured SILENCE from '$mic' (peak=$peak). Is it connected/unmuted? Try: vk mics" >&2
    exit 2
  fi
}

# ---------- quick-action router (Jarvis fast path) ----------
# Short media/system phrases are handled INSTANTLY (AppleScript / Chrome JS) instead
# of a full opencode round-trip. Anything ambiguous or that looks like a coding/agent
# request falls through to the opencode brain (these functions return 1).
#
# Router claims a command only when it is short, unambiguously media/system, and does
# not reference coding/agent work. Volume is system-wide; media control drives the
# video element in the ACTIVE Chrome tab (YouTube etc).

CHROME_APP="${VK_BROWSER:-Google Chrome}"
ROUTE_ACTION=""
ROUTE_MSG=""

js_play="var v=document.querySelector('video');if(!v){'no-video'}else if(v.paused){v.play();'playing'}else{'already-playing'}"
js_pause="var v=document.querySelector('video');if(!v){'no-video'}else if(v.paused){'already-paused'}else{v.pause();'paused'}"
js_next="var b=document.querySelector('.ytp-next-button');if(!b){'no-next'}else{b.click();'next'}"
js_prev="var b=document.querySelector('.ytp-prev-button');if(!b){'no-prev'}else{b.click();'prev'}"
js_skipad="var b=document.querySelector('.ytp-ad-skip-button,.ytp-skip-ad-button');if(!b){'no-ad'}else{b.click();'skipped-ad'}"
js_now="var v=document.querySelector('video');if(!v){'no-video'}else{document.title+' | '+Math.round(v.volume*100)+'%'}"

norm_text() {
  local t="$1"
  t=$(printf '%s' "$t" | tr '[:upper:]' '[:lower:]' | tr -d "'\"" | tr ',' ' ')
  printf '%s' "$t" | tr -s '[:space:]' ' ' | sed -e 's/^ //' -e 's/ $//'
}

has_word() {
  [[ "$1" =~ (^|[^a-z0-9])${2}([^a-z0-9]|$) ]]
}

chrome_running() {
  pgrep -x "$CHROME_APP" >/dev/null 2>&1
}

chrome_exec() {
  local prog out
  prog='tell application "'"$CHROME_APP"'"
try
  set r to execute active tab of front window javascript (system attribute "VK_JS")
  return r
on error errMsg
  return "ERR: " & errMsg
end try
end tell'
  out=$(VK_JS="$1" osascript -e "$prog" 2>&1)
  CHROME_OUT=$(printf '%s' "$out" | tr '\n' ' ')
}

# dry-run detector: sets $ROUTE_ACTION (or returns 1 = let opencode handle it)
route_detect() {
  ROUTE_ACTION=""
  [ "$VK_ROUTER" = "0" ] && return 1
  local text="$1" norm wc
  norm=$(norm_text "$text")
  [ -z "$norm" ] && return 1
  wc=$(printf '%s' "$norm" | wc -w | tr -d ' ')
  (( wc > 8 )) && return 1

  # compound utterances that also reference coding/agent work -> give to the brain
  local w
  for w in scan test run write fix build check show search find explain error bug install report vuln nmap sqlmap http exploit commit push pull fetch branch deploy docker server config code repo log result request attack; do
    if has_word "$norm" "$w"; then return 1; fi
  done

  # ---- system volume (no browser needed) ----
  if has_word "$norm" unmute; then ROUTE_ACTION="vol:unmute"; return 0; fi
  if has_word "$norm" mute; then ROUTE_ACTION="vol:mute"; return 0; fi

  if has_word "$norm" volume; then
    if [[ "$norm" =~ volume[^0-9]{0,12}([0-9]{1,3}) ]] && [[ "$norm" != *" by "* ]]; then
      ROUTE_ACTION="vol:set:${BASH_REMATCH[1]}"
      return 0
    fi
    if has_word "$norm" max; then ROUTE_ACTION="vol:set:100"; return 0; fi
  fi

  local p ups downs
  IFS='|' read -r -a ups <<< "louder|volume up|turn it up|turn up|raise the volume|raise volume|increase the volume|increase volume|make it louder|volume plus|up the volume|crank it up|crank up"
  for p in "${ups[@]}"; do
    [[ "$norm" == *"$p"* ]] && { ROUTE_ACTION="vol:up"; return 0; }
  done
  IFS='|' read -r -a downs <<< "quieter|volume down|turn it down|turn down|lower the volume|lower volume|decrease the volume|decrease volume|make it quieter|volume minus|down the volume|soften"
  for p in "${downs[@]}"; do
    [[ "$norm" == *"$p"* ]] && { ROUTE_ACTION="vol:down"; return 0; }
  done
  if has_word "$norm" volume && has_word "$norm" up && ! has_word "$norm" down; then ROUTE_ACTION="vol:up"; return 0; fi
  if has_word "$norm" volume && has_word "$norm" down && ! has_word "$norm" up; then ROUTE_ACTION="vol:down"; return 0; fi

  # ---- Chrome / YouTube media control (needs a running Chrome) ----
  chrome_running || return 1
  # an explicit OTHER service (Spotify, Tidal…) is NOT the Chrome router's job
  local srv
  for srv in spotify tidal deezer pandora soundcloud; do
    if has_word "$norm" "$srv"; then return 1; fi
  done
  if has_word "$norm" apple && has_word "$norm" music; then return 1; fi
  # a specific request like "play X on youtube" (>=5 words) -> opencode can search it
  if has_word "$norm" youtube && (( wc >= 5 )); then return 1; fi

  local noun hasnoun
  hasnoun=0
  for noun in music song video track playback playlist youtube podcast media; do
    if has_word "$norm" "$noun"; then hasnoun=1; break; fi
  done

  case "$norm" in
    *"now playing"*|*"whats playing"*|*"what is playing"*|*"playing now"*|*"current song"*|*"current video"*|*"what song"*|*"what video"*|*"whos playing"*)
      ROUTE_ACTION="media:now"; return 0 ;;
  esac
  [[ "$norm" == *"skip ad"* || "$norm" == *"skip ads"* || "$norm" == *"skip the ad"* || "$norm" == *"skip commercial"* || "$norm" == *"skip the commercial"* ]] \
    && { ROUTE_ACTION="media:skipad"; return 0; }

  (( hasnoun == 0 )) && return 1

  if has_word "$norm" next || has_word "$norm" forward || [[ "$norm" == *"play next"* ]]; then ROUTE_ACTION="media:next"; return 0; fi
  if has_word "$norm" previous || has_word "$norm" back; then ROUTE_ACTION="media:prev"; return 0; fi
  if has_word "$norm" pause || has_word "$norm" stop || has_word "$norm" halt; then ROUTE_ACTION="media:pause"; return 0; fi
  if has_word "$norm" play || has_word "$norm" resume || has_word "$norm" start || has_word "$norm" continue; then ROUTE_ACTION="media:play"; return 0; fi
  return 1
}

media_exec() {
  local js="$1" okmsg="$2"
  chrome_exec "$js"
  case "$CHROME_OUT" in
    no-video) ROUTE_MSG="📺 no video found in Chrome's active tab" ;;
    no-next)  ROUTE_MSG="⏭ no next track available" ;;
    no-prev)  ROUTE_MSG="⏮ no previous track available" ;;
    no-ad)    ROUTE_MSG="🎉 no ad to skip" ;;
    *ERR:*)   ROUTE_MSG="⚠️ Chrome automation blocked — grant it permission & enable View ▸ Developer ▸ Allow JavaScript from Apple Events" ;;
    *)        ROUTE_MSG="$okmsg" ;;
  esac
}

# execute a detected quick action; on success writes a status reply for the
# floating window and returns 0. On failure returns 1 (falls through to opencode).
route_quick() {
  ROUTE_ACTION=""
  route_detect "$@" || return 1
  ROUTE_MSG=""
  local act="$ROUTE_ACTION" cur n
  case "$act" in
    vol:mute)
      osascript -e 'set volume output muted true' 2>/dev/null
      ROUTE_MSG="🔇 muted"
      ;;
    vol:unmute)
      osascript -e 'set volume output muted false' 2>/dev/null
      ROUTE_MSG="🔊 unmuted"
      ;;
    vol:up|vol:down)
      n=10; [ "$act" = "vol:down" ] && n=-10
      cur=$(osascript -e 'output volume of (get volume settings)' 2>/dev/null)
      [ -z "$cur" ] && cur=50
      n=$((cur+n)); [ "$n" -lt 0 ] && n=0; [ "$n" -gt 100 ] && n=100
      osascript -e "set volume output volume $n" 2>/dev/null
      ROUTE_MSG="🔊 volume $n%"
      ;;
    vol:set:*)
      n=${act#vol:set:}
      [ "$n" -gt 100 ] && n=100
      osascript -e "set volume output volume $n" 2>/dev/null
      ROUTE_MSG="🔊 volume $n%"
      ;;
    media:play)   media_exec "$js_play"   "▶ playing" ;;
    media:pause)  media_exec "$js_pause"  "⏸ paused" ;;
    media:next)   media_exec "$js_next"   "⏭ next track" ;;
    media:prev)   media_exec "$js_prev"   "⏮ previous track" ;;
    media:skipad) media_exec "$js_skipad" "⏭ skipped the ad" ;;
    media:now)
      chrome_exec "$js_now"
      case "$CHROME_OUT" in
        no-video) ROUTE_MSG="📺 no video in Chrome's active tab" ;;
        *ERR:*)   ROUTE_MSG="⚠️ Chrome automation blocked — enable View ▸ Developer ▸ Allow JavaScript from Apple Events" ;;
        *)        ROUTE_MSG="🎵 $(printf '%s' "$CHROME_OUT" | cut -c1-100)" ;;
      esac
      ;;
    *) return 1 ;;
  esac
  printf '%s' "$ROUTE_MSG" > "$KIT/last-reply.txt"
  touch "$KIT/reply-waiting"
  return 0
}

# ---------- commands ----------

cmd_mics() {
  echo "Available input devices:"
  local i=1
  while IFS= read -r dev; do
    [ -z "$dev" ] && continue
    local tag=""
    is_virtual "$dev" && tag="  (virtual - ignored in auto mode)"
    [ "$dev" = "$VK_MIC" ] && tag="$tag  ← saved"
    echo "  $i) $dev$tag"
    i=$((i+1))
  done < <(input_devices)
  echo "Auto mode uses: macOS system default input (follows your current mic)"
  echo "Current setting: ${VK_MIC:-auto}"
}

cmd_mic_pick() {
  if [ -z "$1" ]; then
    cmd_mics
    return
  fi
  if [ "$1" = "auto" ]; then
    update_config 'VK_MIC="auto"'
    echo "✓ mic set to auto-detect"
    return
  fi
  local dev
  if echo "$1" | grep -qxE '[0-9]+'; then
    dev=$(input_devices | sed -n "${1}p")
  else
    dev="$1"
  fi
  input_devices | grep -qxF "$dev" || { echo "❌ no such input device: $dev"; exit 1; }
  update_config "VK_MIC=\"$dev\""
  echo "✓ mic pinned to: $dev (use 'vk mic auto' to go back to auto)"
}

update_config() {
  touch "$CFG"
  grep -v "^VK_MIC=" "$CFG" > "$CFG.tmp" 2>/dev/null
  echo "$1" >> "$CFG.tmp"
  mv "$CFG.tmp" "$CFG"
  chmod 600 "$CFG"
  source "$CFG"
}

cmd_server() {
  case "$1" in
    start)
      if curl -s --max-time 1 -o /dev/null "http://127.0.0.1:$WHISPER_PORT/inference" 2>/dev/null; then
        echo "✓ whisper-server already running on port $WHISPER_PORT"
        return
      fi
      echo "Starting whisper-server on port $WHISPER_PORT (model loads once, stays resident)…"
      nohup whisper-server -m "$MODEL" --host 127.0.0.1 --port "$WHISPER_PORT" -nt --prompt "$VOCAB_PROMPT" \
        > "$KIT/whisper-server.log" 2>&1 &
      echo "✓ started (pid $!). Transcription now skips the per-request model load."
      ;;
    stop)
      pkill -f "whisper-server.*$WHISPER_PORT" && echo "✓ stopped" || echo "not running"
      ;;
    status)
      if curl -s --max-time 1 -o /dev/null "http://127.0.0.1:$WHISPER_PORT/inference" 2>/dev/null; then
        echo "whisper-server: running on port $WHISPER_PORT"
      else
        echo "whisper-server: not running"
      fi
      ;;
    install)
      cmd_server_install
      ;;
    *)
      echo "vk server start|stop|status|install  (install = auto-start at login via launchd)"
      ;;
  esac
}

cmd_server_install() {
  mkdir -p "$KIT" "$HOME/Library/LaunchAgents"
  printf '%s' "$VOCAB_PROMPT" > "$KIT/vocab-prompt.txt"

  # wrapper script (evaluated at runtime)
  cat > "$KIT/whisper-server.sh" <<'WRAPPER'
#!/bin/bash
export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH
KIT="$HOME/.voice-kit"
[ -f "$KIT/config" ] && source "$KIT/config"
exec whisper-server -m "$KIT/models/ggml-large-v3-turbo.bin" \
  --host 127.0.0.1 --port "${VK_WHISPER_PORT:-8081}" \
  -nt --prompt "$(cat "$KIT/vocab-prompt.txt" 2>/dev/null)"
WRAPPER
  chmod +x "$KIT/whisper-server.sh"

  # launch agent plist (absolute paths baked in at install time)
  local PLIST="$HOME/Library/LaunchAgents/com.prakkash.vk-whisper-server.plist"
  cat > "$PLIST" <<PLISTEOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.prakkash.vk-whisper-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$KIT/whisper-server.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
    <key>ThrottleInterval</key><integer>10</integer>
  </dict>
  <key>StandardOutPath</key><string>$KIT/whisper-server.log</string>
  <key>StandardErrorPath</key><string>$KIT/whisper-server.log</string>
</dict>
</plist>
PLISTEOF

  launchctl unload "$PLIST" 2>/dev/null
  launchctl load "$PLIST"
  echo "✓ whisper-server installed as a login item (auto-starts at boot, restarts on crash)"
}

case "$1" in
  rec)
    record "${2:-6}"
    raw=$(transcribe "$WAV")
    if [ -z "$raw" ]; then echo "⚠️  empty transcript" >&2; exit 1; fi
    echo "📝 raw: $raw" >&2
    final=$(format_llm "$raw")
    printf '%s' "$final" | pbcopy
    echo "✨ $final   [copied to clipboard]"
    ;;
  stt)    transcribe "$2" ;;
  fmt)    format_llm "$2" ;;
  mics)   cmd_mics ;;
  mic)    cmd_mic_pick "$2" ;;
  server) cmd_server "$2" ;;
  mic-resolve)
    mic=$(resolve_mic)
    [ -z "$mic" ] && { echo "❌ no mic" >&2; exit 1; }
    echo "$mic"
    ;;
  hold)
    # process a hold-to-talk recording (/tmp/vk-hold.wav), paste-ready text on stdout
    # --raw = verbatim mode: output EXACTLY what was said, no rephrasing, no shortening
    sox "$HOLD_WAV" -r 16000 -c 1 "$WAV" 2>/dev/null
    peak=$(peak_of "$WAV")
    if python3 -c "import sys; sys.exit(0 if float(sys.argv[1] or 0) < $SILENCE_THRESHOLD else 1)" "$peak"; then
      echo "⚠️ silence" >&2
      exit 2
    fi
    raw=$(transcribe "$WAV")
    [ -z "$raw" ] && { echo "⚠️ empty transcript" >&2; exit 1; }
    case "$2" in
      --raw) echo "$raw" ;;
      *)
        final=$(format_llm "$raw")
        if route_quick "$final"; then
          # fast-path handled it (status went to the reply window) — tell
          # Hammerspoon NOT to send anything to opencode
          echo "__VK_QUICK__"
        else
          echo "$final"
        fi
        ;;
    esac
    ;;
  route)
    # vk route "text"        dry-run: print which quick action would match
    # vk route --act "text"  execute it and show the status
    case "$2" in
      --act)
        if route_quick "$3"; then
          echo "handled → $ROUTE_MSG"
        else
          echo "no match — would go to opencode"
        fi
        ;;
      *)
        if route_detect "$2"; then
          echo "match → $ROUTE_ACTION"
        else
          echo "no match — would go to opencode"
        fi
        ;;
    esac
    ;;
  test)
    sox -r 16000 -c 1 -n "$WAV" synth 3 sine 300-800 2>/dev/null
    echo "transcribing tone (expect empty/garbage - just testing plumbing):"
    transcribe "$WAV" && echo "✅ whisper pipeline OK"
    ;;
  *)
    echo "vk — your local voice kit"
    echo "  vk rec [secs]   record -> transcribe -> format -> clipboard"
    echo "  vk hold [--raw] process push-to-talk recording (--raw = verbatim)"
    echo "  vk mics         list input devices"
    echo "  vk mic <n|name|auto>  pin a mic (or auto-detect)"
    echo "  vk server start|stop|status  resident whisper server (lower latency)"
    echo "  vk stt <wav>    transcribe existing file"
    echo "  vk fmt \"text\"  run LLM formatter only"
    echo "  vk route \"text\"  [--act] test the quick-action router (volume/media)"
    echo "  vk test         whisper plumbing self-test"
    ;;
esac
