# vk voice-kit configuration
# Copy to ~/.voice-kit/config and fill in your values.

# Groq API key (free tier works) for the LLM formatter.
# Get one: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_key_here"

# Formatter model (any Groq model; fast + cheap recommended)
export VK_FORMAT_MODEL="openai/gpt-oss-20b"

# Optional: use a different OpenAI-compatible formatter endpoint.
# VK_FORMAT_URL="https://api.deepseek.com/chat/completions"
# VK_FORMAT_KEY="sk-..."

# Set VK_RAW=1 to skip LLM formatting entirely (fully offline dictation).
# VK_RAW=1

# Microphone: "auto" (or unset) follows the macOS system default input device —
# it auto-switches when you connect/disconnect earphones, Bluetooth, USB mics, etc.
# Pin a specific device name only if you need to force one:
# VK_MIC="auto"

# Whisper server port (used by `vk server start` for low-latency transcription).
# VK_WHISPER_PORT=8081

# --- Jarvis fast-path router -----------------------------------------------
# Quick media/system phrases ("play", "pause", "next track", "volume up",
# "mute", "skip ad", "what's playing") are handled INSTANTLY via Chrome/YouTube
# + system volume instead of a full opencode round-trip. Everything else —
# including any request that also mentions coding/agent work — still goes to
# the opencode brain. VK_ROUTER=0 disables this entirely.
# VK_ROUTER=1

# Browser the router drives for media commands (drives the video element in the
# active tab). One-time requirement: Chrome's View ▸ Developer ▸
# "Allow JavaScript from Apple Events" must be enabled.
# VK_BROWSER="Google Chrome"

